{
  "name": "aki",
  "version": "0.1.0",
  "private": true,
  "description": "Aki — enterprise AI agent platform",
  "scripts": {
    "dev:web": "cd apps/web && npm run dev",
    "dev:desktop": "cd apps/aki-desktop && npm run dev",
    "build:web": "cd apps/web && npm run build",
    "build:desktop": "cd apps/aki-desktop && npm run build",
    "build:shared": "cd packages/shared && npm run build",
    "lint:api": "cd services/api && ruff check app tests alembic",
    "test:api": "cd services/api && python -m pytest tests -q",
    "preview:web": "cd apps/web && npm run preview"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
