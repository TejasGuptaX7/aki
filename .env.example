# ─── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_ENV=dev                          # dev | staging | prod
NEXT_PUBLIC_SITE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
AGENT_BASE_URL=http://localhost:8080

# ─── Postgres (Supabase) ─────────────────────────────────────────────────────
# Use the pooled (transaction mode) URL for the API; direct URL for Alembic.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aki
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/aki
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ─── Auth (Clerk) ────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER=                    # https://<your-app>.clerk.accounts.dev
CLERK_JWKS_URL=                      # ${CLERK_JWT_ISSUER}/.well-known/jwks.json
CLERK_WEBHOOK_SECRET=

# ─── Agent runtime (Hermes) ──────────────────────────────────────────────────
HERMES_VERSION=0.4.0
HERMES_GATEWAY_URL=http://localhost:8080
HERMES_API_KEY=                      # shared secret API ↔ agent gateway
HERMES_DATA_DIR=/var/lib/aki/hermes  # per-org workspace mount root

# ─── Model providers ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=                   # default inference under Hermes
OPENAI_API_KEY=                      # embeddings: text-embedding-3-small
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMS=1536

# ─── Connectors ──────────────────────────────────────────────────────────────
COMPOSIO_API_KEY=
COMPOSIO_BASE_URL=https://backend.composio.dev

# ─── Email / waitlist ────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_ADDRESS=

# ─── Observability ───────────────────────────────────────────────────────────
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ─── Billing (later) ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
