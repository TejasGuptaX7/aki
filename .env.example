# ─── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_ENV=dev                          # dev | staging | prod
NEXT_PUBLIC_SITE_URL=http://localhost:3000
WEB_BASE_URL=http://localhost:3000   # OAuth-callback redirect destination
API_BASE_URL=http://localhost:8000
AGENT_BASE_URL=http://localhost:8080
# X-Dev-Org-Id header bypass for the auth dependency. Requires BOTH
# APP_ENV=dev AND this flag. Production must leave this false (the default).
ALLOW_DEV_AUTH_BYPASS=false
# Comma-separated. apps/web origin in dev; full prod domain(s) in prod.
CORS_ORIGINS=http://localhost:3000

# ─── Postgres (Supabase) ─────────────────────────────────────────────────────
# Use the pooled (transaction mode) URL for the API; direct URL for Alembic.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aki
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/aki
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ─── Auth (Clerk) ────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER=                    # https://<your-app>.clerk.accounts.dev
CLERK_JWKS_URL=                      # ${CLERK_JWT_ISSUER}/.well-known/jwks.json
CLERK_WEBHOOK_SECRET=

# ─── Agent runtime (Hermes) ──────────────────────────────────────────────────
HERMES_VERSION=0.4.0
HERMES_GATEWAY_URL=http://localhost:8080
HERMES_API_KEY=                      # shared secret API ↔ agent gateway
HERMES_DATA_DIR=~/.aki/hermes        # per-org workspace mount root (prod: /var/lib/aki/hermes)
HERMES_IDLE_MINUTES=15               # hibernate per-org container after N min idle
AGENT_RUNTIME=local                  # local | railway | modal

# Redis — per-org lifecycle lock and NOTIFY cache.
REDIS_URL=redis://localhost:6379/0

# ─── Model providers ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=                   # optional alt inference provider
OPENAI_API_KEY=                      # default inference + embeddings
HERMES_MODEL_PROVIDER=openai         # openai | anthropic | …
HERMES_MODEL_NAME=gpt-5
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMS=1536

# ─── Brain ───────────────────────────────────────────────────────────────────
BRAIN_CHUNK_TOKENS=800              # approx tokens per chunk (~4 chars/token)
BRAIN_CHUNK_OVERLAP=100             # chars carried into the next chunk

# ─── Aki desktop device JWTs ─────────────────────────────────────────────────
# Ed25519 PEM (private key — pyjwt derives the pubkey from it for verify).
# Generate locally:
#   ssh-keygen -t ed25519 -m PEM -f device-jwt-key -N ""
#   awk 'NF' device-jwt-key | tr '\n' '|' | sed 's/|/\\n/g'
# then paste the single-line value here.
DEVICE_JWT_SIGNING_KEY=

# ─── Connectors ──────────────────────────────────────────────────────────────
COMPOSIO_API_KEY=
COMPOSIO_BASE_URL=https://backend.composio.dev
COMPOSIO_WEBHOOK_SECRET=
# Per-toolkit Auth Config IDs (from Composio dashboard → Auth Configs).
# Each enabled toolkit gets its own ac_xxx id; add new ones as toolkits land.
COMPOSIO_GMAIL_AUTH_CONFIG_ID=
COMPOSIO_SLACK_AUTH_CONFIG_ID=        # legacy: user-OAuth Slack
COMPOSIO_SLACKBOT_AUTH_CONFIG_ID=     # preferred for company use: Slack bot

# Browser Use Cloud — long-tail no-API tools via browser-harness
BROWSER_USE_API_KEY=

# ─── Email / waitlist ────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_ADDRESS=

# ─── Observability ───────────────────────────────────────────────────────────
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ─── Billing (later) ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
