# Local dev env for `docker compose up` in this directory.
# Copy to .env (gitignored) and edit as needed.

# REQUIRED — shared secret between the harness and the API gateway.
# In prod, generate with: openssl rand -hex 32
BROWSER_HARNESS_API_KEY=dev-secret-change-me

# minio (R2 emulator) creds — the docker-compose service uses these.
MINIO_ROOT_USER=aki
MINIO_ROOT_PASSWORD=aki-dev-secret

# SSRF allowlist for internal company hosts (CSV; glob OK).
# Leave empty in dev — public sites only.
BROWSER_HARNESS_ALLOWED_HOSTS=

# Pool tuning (defaults baked in; uncomment to override).
# BROWSER_HARNESS_IDLE_SECONDS=600
# BROWSER_HARNESS_HARD_MAX_SECONDS=1800

# Logging
LOG_LEVEL=INFO
