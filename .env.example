# ─── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_ENV=dev                          # dev | staging | prod
NEXT_PUBLIC_SITE_URL=http://localhost:3000
WEB_BASE_URL=http://localhost:3000   # OAuth-callback redirect destination
API_BASE_URL=http://localhost:8000
AGENT_BASE_URL=http://localhost:8080
# X-Dev-Org-Id header bypass for the auth dependency. Requires BOTH
# APP_ENV=dev AND this flag. Production must leave this false (the default).
ALLOW_DEV_AUTH_BYPASS=false
# Comma-separated. apps/web origin in dev; full prod domain(s) in prod.
CORS_ORIGINS=http://localhost:3000

# ─── Postgres (Supabase) ─────────────────────────────────────────────────────
# Use the pooled (transaction mode) URL for the API; direct URL for Alembic.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aki
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/aki
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ─── Auth (Clerk) ────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER=                    # https://<your-app>.clerk.accounts.dev
CLERK_JWKS_URL=                      # ${CLERK_JWT_ISSUER}/.well-known/jwks.json
CLERK_WEBHOOK_SECRET=

# ─── Agent runtime (Hermes) ──────────────────────────────────────────────────
HERMES_VERSION=0.4.0
HERMES_GATEWAY_URL=http://localhost:8080
HERMES_API_KEY=                      # shared secret API ↔ agent gateway
HERMES_DATA_DIR=~/.aki/hermes        # per-org workspace mount root (prod: /var/lib/aki/hermes)
HERMES_IDLE_MINUTES=15               # hibernate per-org container after N min idle
AGENT_RUNTIME=local                  # local | railway | modal

# Redis — per-org lifecycle lock and NOTIFY cache.
REDIS_URL=redis://localhost:6379/0

# ─── Model providers ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=                   # optional alt inference provider
OPENAI_API_KEY=                      # default inference + embeddings
HERMES_MODEL_PROVIDER=openai         # openai | anthropic | …
HERMES_MODEL_NAME=gpt-5
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMS=1536

# ─── Connectors ──────────────────────────────────────────────────────────────
# Pipedream Connect — primary long-tail API layer (white-label OAuth).
# Create the OAuth client at Pipedream dashboard → Settings → API.
PIPEDREAM_PROJECT_ID=
PIPEDREAM_CLIENT_ID=
PIPEDREAM_CLIENT_SECRET=
PIPEDREAM_ENVIRONMENT=development      # development | production
PIPEDREAM_BASE_URL=https://api.pipedream.com

# Arcade.dev — first-class agent-auth for top-20 tools.
ARCADE_API_KEY=
ARCADE_BASE_URL=https://api.arcade.dev

# Self-hosted Browser Harness (services/browser-harness).
# Local dev: http://localhost:7900 (via docker-compose).
# Production: http://aki-browser-harness.internal:7900 (Fly internal).
BROWSER_HARNESS_URL=
BROWSER_HARNESS_API_KEY=               # shared secret; matches harness app env

# Browser Use Cloud — fallback for deterministic browser ops.
BROWSER_USE_API_KEY=

# Slack — Aki app at api.slack.com; OAuth runs via Pipedream so the consent
# screen is white-labeled. Set when you create the Aki Slack app.
SLACK_SIGNING_SECRET=
SLACK_CLIENT_ID=
SLACK_APP_ID=

# ─── Rate limits + circuit breaker ───────────────────────────────────────────
# Per-org daily caps. Without billing, these are the abuse defense.
RATE_LIMIT_DAILY_ACTIONS=500
RATE_LIMIT_DAILY_BROWSER_SECONDS=3600
RATE_LIMIT_DAILY_LLM_CENTS=5000        # cents = $50
# Global circuit breaker: pause new signups when platform-wide daily spend
# crosses this ceiling (cents). Existing users unaffected.
PLATFORM_DAILY_SPEND_CAP_CENTS=50000   # cents = $500

# ─── Internal URLs ───────────────────────────────────────────────────────────
# What the Hermes container uses to reach the control plane (different from
# API_BASE_URL because the container's `localhost` is itself). Mac dev:
# host.docker.internal. Fly: internal hostname.
API_INTERNAL_URL=http://host.docker.internal:8000

# ─── Email / waitlist ────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_ADDRESS=

# ─── Observability ───────────────────────────────────────────────────────────
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ─── Billing (later) ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
